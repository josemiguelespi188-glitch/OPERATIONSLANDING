# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ClickUp — required for the request -> ClickUp task sync
# Personal API Token: ClickUp -> Settings -> Apps -> API Token (starts with pk_)
CLICKUP_API_TOKEN=
# JSON map of request type slug -> ClickUp List ID. All 7 keys are required
# for that request type to sync; a missing key marks the request "failed"
# (still retryable from the Admin panel) instead of hardcoding a list.
# Example:
# CLICKUP_LIST_ID_MAP={"ira-funding-request":"901234567","title-transfer-request":"901234568","redemption-request":"901234569","investor-information-update":"901234570","account-maintenance-request":"901234571","document-request":"901234572","custom-request":"901234573"}
CLICKUP_LIST_ID_MAP=

# Future integration (not required yet — see lib/integrations/n8n.ts)
N8N_REQUEST_WEBHOOK_URL=
