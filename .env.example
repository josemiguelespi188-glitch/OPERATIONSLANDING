# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ClickUp — required for the request -> ClickUp task sync
# Personal API Token: ClickUp -> Settings -> Apps -> API Token (starts with pk_)
CLICKUP_API_TOKEN=
# JSON map of request type slug -> ClickUp List ID. A slug with no key
# marks the request "failed" (still retryable from the Admin panel)
# instead of hardcoding a list.
#
# Real IDs for all 9 lists live under the "Axis Operations Hub" folder
# (Investor Relations space) as of Aug 2026 — see CLAUDE.md for the full
# table (name -> slug -> list ID). custom-request was removed from the
# Hub, refund-request is new. `npm run clickup:provision` (see
# scripts/clickup/provision-forms.mjs) creates/fills in custom fields for
# whichever lists still need it and prints their IDs to merge into
# CUSTOM_FIELD_MAP.
# CLICKUP_LIST_ID_MAP={"title-transfer-request":"901114002885","redemption-request":"901114014583","ira-funding-request":"901112504693","refund-request":"901114418101","side-letter-request":"901114320630","investor-information-update":"901114375425","account-maintenance-request":"901114375429","document-request":"901114375430","axiskey-report-request":"901114375435"}
CLICKUP_LIST_ID_MAP=

# ClickUp -> us: verifies the taskStatusUpdated webhook that mirrors a
# ClickUp task's live status back onto its matching `requests` row
# (app/api/webhooks/clickup/route.ts). This is the `secret` returned when
# creating the webhook via POST /team/{team_id}/webhook — see the setup
# steps in chat/README for the exact request.
CLICKUP_WEBHOOK_SECRET=

# Future integration (not required yet — see lib/integrations/n8n.ts)
N8N_REQUEST_WEBHOOK_URL=
