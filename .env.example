# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ClickUp — required for the request -> ClickUp task sync
# Personal API Token: ClickUp -> Settings -> Apps -> API Token (starts with pk_)
CLICKUP_API_TOKEN=
# JSON map of request type slug -> ClickUp List ID. A slug with no key
# marks the request "failed" (still retryable from the Admin panel)
# instead of hardcoding a list.
#
# Real IDs for the 4 lists live under the "Axis Operations Hub" folder
# (Investor Relations space) as of Aug 2026:
#   ira-funding-request     -> 901112504693
#   title-transfer-request  -> 901114002885
#   redemption-request      -> 901114014583
#   side-letter-request     -> 901114320630
# investor-information-update, account-maintenance-request, custom-request,
# and axiskey-report-request have no ClickUp list yet — run
# `npm run clickup:provision` (see scripts/clickup/provision-forms.mjs) to
# create them (and side-letter-request's missing custom fields) in one
# shot, then add the printed IDs here and merge the printed custom-field
# IDs into CUSTOM_FIELD_MAP in lib/integrations/clickup.ts.
# document-request is intentionally left out — no form spec for it yet.
# CLICKUP_LIST_ID_MAP={"ira-funding-request":"901112504693","title-transfer-request":"901114002885","redemption-request":"901114014583","side-letter-request":"901114320630"}
CLICKUP_LIST_ID_MAP=

# ClickUp -> us: verifies the taskStatusUpdated webhook that mirrors a
# ClickUp task's live status back onto its matching `requests` row
# (app/api/webhooks/clickup/route.ts). This is the `secret` returned when
# creating the webhook via POST /team/{team_id}/webhook — see the setup
# steps in chat/README for the exact request.
CLICKUP_WEBHOOK_SECRET=

# Future integration (not required yet — see lib/integrations/n8n.ts)
N8N_REQUEST_WEBHOOK_URL=
