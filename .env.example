# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ClickUp — required for the request -> ClickUp task sync
# Personal API Token: ClickUp -> Settings -> Apps -> API Token (starts with pk_)
CLICKUP_API_TOKEN=
# JSON map of request type slug -> ClickUp List ID. A slug with no key
# marks the request "failed" (still retryable from the Admin panel)
# instead of hardcoding a list.
#
# Real IDs for the 3 lists live under the "Axis Operations Hub" folder
# (Investor Relations space) as of Aug 2026:
#   ira-funding-request     -> 901112504693
#   title-transfer-request  -> 901114002885
#   redemption-request      -> 901114014583
# The remaining 4 request types have no ClickUp list yet — leave them out
# of the map until one exists.
# CLICKUP_LIST_ID_MAP={"ira-funding-request":"901112504693","title-transfer-request":"901114002885","redemption-request":"901114014583"}
CLICKUP_LIST_ID_MAP=

# Future integration (not required yet — see lib/integrations/n8n.ts)
N8N_REQUEST_WEBHOOK_URL=
